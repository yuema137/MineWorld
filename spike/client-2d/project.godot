; MineWorld renderer-integration spike — 2D reference client.
; Top-down. Renders an Observation and submits an ActionIntent from a click.

config_version=5

[application]
config/name="MineWorld spike — 2D client"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1000
window/size/viewport_height=640
