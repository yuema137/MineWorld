=== 3. walk: the client moves in its own space and reports where ====
--> {"t": "submit", "token": "p1", "request": {"actor": "4", "action_type": "arrive", "target": null, "payload": {"action_type": "arrive", "payload": {"location": {"place": {"entity": "1", "entity_type": "place"}, "local": {"x": 1200, "y": 1400, "z": 0}, "facing": {"yaw": 0, "pitch": null}}}}, "actor_location": {"place": {"entity": "1", "entity_type": "place"}, "local": {"x": 1200, "y": 1400, "z": 0}, "facing": {"yaw": 0, "pitch": null}}}}
<-- {"t": "result", "token": "p1", "action_id": "1", "result": {"accepted": {"events": ["5"]}}}

