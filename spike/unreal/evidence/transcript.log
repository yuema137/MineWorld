    [{"action_type": "talk", "target": "2", "available": true, "unavailable_reason": null, "requirement": {"place": "same_place_as_actor", "within_range": 3000, "requires_line_of_access": false, "requires_target_available": true}}]

=== 5. talk, now that the server says it may ========================
--> {"t": "submit", "token": "p2", "request": {"actor": "4", "action_type": "talk", "target": "2", "payload": {"action_type": "talk", "payload": {"utterance": "hello Alice, from a client with no game engine"}}, "actor_location": {"place": {"entity": "1", "entity_type": "place"}, "local": {"x": 1200, "y": 1400, "z": 0}, "facing": {"yaw": 0, "pitch": null}}}}
<-- {"t": "result", "token": "p2", "action_id": "2", "result": {"accepted": {"events": ["6", "7"]}}}

=== 6. refusals =====================================================

-- a float where the contract declares an i32, at the PROTOCOL boundary
--> {"t": "submit", "token": "p1", "request": {"actor": "5", "action_type": "talk", "target": "2", "payload": {"action_type": "talk", "payload": {"utterance": "x"}}, "actor_location": {"place": {"entity": "1", "entity_type": "place"}, "local": {"x": 1500.0, "y": 0, "z": 0}, "facing": null}}}
<-- {"t": "refused", "token": "p1", "code": "malformed_frame", "detail": "invalid type: floating point `1500.0`, expected i32"}

-- the same float inside a SYSTEM payload
--> {"t": "submit", "token": "p2", "request": {"actor": "5", "action_type": "arrive", "target": null, "payload": {"action_type": "arrive", "payload": {"location": {"place": {"entity": "1", "entity_type": "place"}, "local": {"x": 1500.0, "y": 0, "z": 0}, "facing": null}}}, "actor_location": null}}
<-- {"t": "result", "token": "p2", "action_id": "4", "result": {"rejected": {"system": {"code": "malformed-payload", "detail": "a arrive action payload cannot be read as arrive"}}}}

-- an unquoted 64-bit identity (accepted, for a hand-written fixture)
--> {"t": "submit", "token": "n1", "request": {"actor": 5, "action_type": "talk", "target": 2, "payload": {"action_type": "talk", "payload": {"utterance": "x"}}, "actor_location": null}}
<-- {"t": "result", "token": "n1", "action_id": "5", "result": {"rejected": "too_far_away"}}

-- asking the world to act as somebody else
--> {"t": "submit", "token": "x1", "request": {"actor": "2", "action_type": "talk", "target": "3", "payload": {"action_type": "talk", "payload": {"utterance": "x"}}, "actor_location": null}}
<-- {"t": "refused", "token": "x1", "code": "actor_not_observer", "detail": "a client may only ask the world to act as its own observer; the actor of this request is somebody else"}

-- the two halves of action_type disagreeing
--> {"t": "submit", "token": "d1", "request": {"actor": "5", "action_type": "talk", "target": "2", "payload": {"action_type": "arrive", "payload": {}}, "actor_location": null}}
<-- {"t": "refused", "token": "d1", "code": "malformed_frame", "detail": "an action intent for talk cannot carry a arrive payload"}

-- a frame that asserts a fact about the world
--> {"t": "set_state", "money": 5000}
<-- {"t": "refused", "code": "unknown_frame", "detail": "this protocol has no frame of kind \"set_state\"; a client may only join or submit"}
