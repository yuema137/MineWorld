# English wording shared by both reference clients: the shared catalog layer (clients/shared/SETTINGS.md
# §6.2; docs/DECISIONS.md ARC-70 and its 2026-10-09 note).
#
# This file is the layer's source catalog; messages.pot is generated from it by
# tests/acceptance/tests/client_text.rs. Keys built from data: action.<type>, action.<type>.done,
# reason.<code>. The action.* and reason.* entries moved here verbatim from the 2D pack's en.po (S12
# 13b), keys unchanged (step-20 SD-SET-a-17), except action.move, whose text is neutral here; the 2D
# pack keeps its own wording of it as an override (step-20 F-4). Wording holds no rule.
msgid ""
msgstr ""
"Project-Id-Version: mineworld-shared-settings 0.1.0\n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

