.godot/
# The launcher's local world save (`./mineworld-slice --world`, `--fresh` deletes it).
.save/
# capture output is scratch -- except the slice's preview package, which is
# the reviewed artefact (VISUAL_SLICE.md sec.12, ARC-24) and is committed
shots/*
!shots/slice/
shots/slice/*
!shots/slice/preview/
!shots/slice/review/
# the far-field regression views (RL-e0 §7) are committed too
!shots/social-cafe/
shots/social-cafe/*
!shots/social-cafe/farfield/
shots/social-cafe/farfield/*.import
screenshots/*.import
preview_*.png
preview_*.png.import
compare_*.png
compare_*.png.import
