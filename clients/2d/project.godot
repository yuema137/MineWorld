; MineWorld 2D reference client (step-13, S12).
; Godot 4.7. Presentation and acquisition only: no world rule lives here (ARC-47).
; The input map is built at runtime by scripts/app.gd; the art is a Presentation Pack read from disk
; at runtime (clients/2d/PRESENTATION.md), so nothing under res:// is an asset.

config_version=5

[application]

config/name="MineWorld 2D"
run/main_scene="res://scenes/app.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/quit_on_go_back=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.878, 0.925, 0.933, 1)
