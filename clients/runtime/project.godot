; The shared Godot runtime of a release bundle (step-23 PR S23-RT, ARC-80). It holds no game code: its one
; scene loads the client named by --client=<key> (its pack and scene from BUNDLE.toml) and applies that
; client's run-time settings. This file holds only the settings both clients need at start-up, with the
; same values as theirs; scripts/package.py checks that before every export.
config_version=5

[application]

config/name="MineWorld"
run/main_scene="res://runtime/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/use_custom_user_dir=true
config/custom_user_dir_name="MineWorld"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
