# English wording of the 2D reference client (clients/2d/PRESENTATION.md §7, docs/DECISIONS.md ARC-70).
#
# The pack layer of the client's wording (clients/shared/SETTINGS.md §6.2): read after the shared layer,
# so an entry here replaces the shared one, marked `#. override`. Keys built from data: action.<type>,
# action.<type>.done, reason.<code> (in the shared layer). A key missing everywhere is shown as a
# readable form of its last part, so a pack that words fewer things still plays. Wording holds no
# rule: no number, no condition.
msgid ""
msgstr ""
"Project-Id-Version: mineworld-default-2d 0.1.0\n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

# The action.* and reason.* entries both clients use live in the shared layer,
# clients/shared/settings/locale/ (moved there verbatim by S20 SET-a, keys unchanged). This pack keeps
# its own wording of one of them: walking, which in this client is a click on the floor.
#. override
msgid "action.move"
msgstr "Walk (click where to go)"

