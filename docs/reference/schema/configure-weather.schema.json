{
  "$comment": "GENERATED by `mineworld reference` from mineworld 0.1.0. Do not edit.",
  "$defs": {
    "Attachment": {
      "description": "A file in the World Pack's data/ directory, written with / on every platform, such as data/weather/station.csv. No \\, no drive, no empty, . or .. part; at most 4 MiB.",
      "pattern": "^data(/[^/\\\\:]+)+$",
      "type": "string"
    },
    "Fill": {
      "description": "What a run of more than 3 days missing from the record becomes: rules (the rules draw them) or none (the configuration is refused).",
      "oneOf": [
        {
          "const": "rules",
          "description": "The rules draw them.",
          "type": "string"
        },
        {
          "const": "none",
          "description": "The configuration is refused.",
          "type": "string"
        }
      ]
    },
    "Month": {
      "additionalProperties": false,
      "description": "One month's climate, every value an integer in its unit; tmin_dc is below tmax_dc.",
      "properties": {
        "fog_permille": {
          "description": "The chance of fog on a day, per mille.",
          "format": "int64",
          "maximum": 1000,
          "minimum": 0,
          "type": "integer"
        },
        "overcast_morning_permille": {
          "description": "The chance of an overcast morning on a dry day, per mille.",
          "format": "int64",
          "maximum": 1000,
          "minimum": 0,
          "type": "integer"
        },
        "p_wet_after_dry": {
          "description": "The chance, per mille, that a day is wet when the day before was dry.",
          "format": "int64",
          "maximum": 1000,
          "minimum": 0,
          "type": "integer"
        },
        "p_wet_after_wet": {
          "description": "The chance, per mille, that a day is wet when the day before was wet too.",
          "format": "int64",
          "maximum": 1000,
          "minimum": 0,
          "type": "integer"
        },
        "rain_tenth_mm": {
          "$ref": "#/$defs/Quintiles",
          "description": "A wet day's rain, as five non-decreasing quintile amounts in 0.1 mm, each from 3 to 10000."
        },
        "t_ar_permille": {
          "description": "How much of yesterday's stray carries into today, per mille.",
          "format": "int64",
          "maximum": 999,
          "minimum": 0,
          "type": "integer"
        },
        "t_noise_dc": {
          "description": "The largest random swing of a day's temperatures from the means, in 0.1 °C.",
          "format": "int64",
          "maximum": 200,
          "minimum": 0,
          "type": "integer"
        },
        "thunder_permille": {
          "description": "The chance that a wet day has thunder, per mille.",
          "format": "int64",
          "maximum": 1000,
          "minimum": 0,
          "type": "integer"
        },
        "tmax_dc": {
          "description": "The mean daily high, in 0.1 °C (215 is 21.5 °C).",
          "format": "int64",
          "maximum": 600,
          "minimum": -900,
          "type": "integer"
        },
        "tmin_dc": {
          "description": "The mean daily low, in 0.1 °C; below `tmax_dc`.",
          "format": "int64",
          "maximum": 600,
          "minimum": -900,
          "type": "integer"
        },
        "wet_tmax_shift_dc": {
          "description": "How much a wet day's high differs from the mean, in 0.1 °C (negative: cooler).",
          "format": "int64",
          "maximum": 200,
          "minimum": -200,
          "type": "integer"
        },
        "wind_dms": {
          "description": "The mean wind speed, in 0.1 m/s.",
          "format": "int64",
          "maximum": 1000,
          "minimum": 0,
          "type": "integer"
        },
        "wind_from_deg": {
          "description": "The direction the wind mostly blows from, in degrees clockwise from north.",
          "format": "int64",
          "maximum": 359,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "p_wet_after_dry",
        "p_wet_after_wet",
        "rain_tenth_mm",
        "tmax_dc",
        "tmin_dc",
        "t_noise_dc",
        "t_ar_permille",
        "wet_tmax_shift_dc",
        "fog_permille",
        "thunder_permille",
        "overcast_morning_permille",
        "wind_dms",
        "wind_from_deg"
      ],
      "type": "object"
    },
    "Quintiles": {
      "description": "Exactly five amounts, in 0.1 mm.",
      "items": {
        "format": "int64",
        "type": "integer"
      },
      "maxItems": 5,
      "minItems": 5,
      "type": "array"
    },
    "RecordConfiguration": {
      "additionalProperties": false,
      "description": "The record a world replays: a station's daily weather, as a file in the World Pack's data/.",
      "properties": {
        "data": {
          "$ref": "#/$defs/Attachment",
          "description": "The record file, made by tools/weather-fetch: a CSV under data/."
        },
        "first_year": {
          "description": "The record year the world's first year replays.",
          "format": "int32",
          "type": "integer"
        },
        "station": {
          "$ref": "#/$defs/Station",
          "description": "The station the record comes from, for provenance."
        }
      },
      "required": [
        "station",
        "data",
        "first_year"
      ],
      "type": "object"
    },
    "Rules": {
      "additionalProperties": false,
      "description": "The climate the weather is drawn from: twelve months of parameters, January first.",
      "properties": {
        "months": {
          "description": "Exactly twelve months, January first.",
          "items": {
            "$ref": "#/$defs/Month"
          },
          "maxItems": 12,
          "minItems": 12,
          "type": "array"
        }
      },
      "required": [
        "months"
      ],
      "type": "object"
    },
    "Source": {
      "description": "Where the days come from: rules or record.",
      "enum": [
        "rules",
        "record"
      ],
      "type": "string"
    },
    "Station": {
      "description": "The weather station the record comes from, such as USW00023188: provenance only, printable ASCII.",
      "type": "string"
    }
  },
