# Personal standards overlay: untracked is what makes it personal.
.structured-coding/standards.local.md

# Structured Coding session state written by the optional presets.
.structured-coding/sessions/
.structured-coding/state/

# Rust
/target/
# CI's Cargo home inside the checkout (.github/actions/layer)
/.ci/
**/*.rs.bk

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/

# Local worlds, saves, and evidence artifacts
*.sqlite
*.sqlite-journal
/saves/
/artifacts/

# OS
.DS_Store

# Renderer-integration spike: engine caches and build output
spike/**/.godot/
spike/server/target/

# Scratch files a shell-quoting slip can create at the repo root: a filename that
# is itself a JSON object. Two were committed to main before this line existed.
{"*

# Personal, per-machine agent authorization. This is one developer's grant for their
# own environment, never repository policy: a contributor inherits it silently
# otherwise, which is how a broad permission spreads without anybody deciding to
# grant it. `.claude/settings.json` is for shared project rules and is tracked when
# it has any.
.claude/settings.local.json
