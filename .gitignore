# Personal standards overlay: untracked is what makes it personal.
.structured-coding/standards.local.md

# Structured Coding session state written by the optional presets.
.structured-coding/sessions/
.structured-coding/state/

# Rust
/target/
# CI's Cargo home inside the checkout (.github/actions/layer)
/.ci/
**/*.rs.bk

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
venv/

# Node
node_modules/

# Local worlds, saves, and evidence artifacts
*.sqlite
*.sqlite-journal
/saves/
/artifacts/

# OS
.DS_Store

# Renderer-integration spike: engine caches and build output
spike/**/.godot/
spike/server/target/

# Scratch files a shell-quoting slip can create at the repo root: a filename that
# is itself a JSON object. Two were committed to main before this line existed.
# Written `[{]` rather than `{`: Git reads both the same, and ruff, which honours this
# file, parses `{` as the start of a glob alternation and refuses the whole file.
[{]"*

# Personal, per-machine agent authorization. This is one developer's grant for their
# own environment, never repository policy: a contributor inherits it silently
# otherwise, which is how a broad permission spreads without anybody deciding to
# grant it. `.claude/settings.json` is for shared project rules and is tracked when
# it has any.
.claude/settings.local.json

# Credentials. Keys live outside the tree (`~/.config/mineworld/secrets.env`); these
# patterns are a guard against a copy landing inside it.
.env
*.env
secrets*
# `.env.local`, `.env.production` and the like, which `*.env` does not match (R-P5-12). The example
# file holds variable names with empty values and is tracked
# (cognition/lm-controller/examples/.env.example).
.env.*
!.env.example
# The one module that resolves a key (D-P5-9) is source code, and holds no value; `secrets*` above
# would otherwise ignore it.
!/cognition/lm-controller/src/mineworld_cognition/secrets.py
