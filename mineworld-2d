#!/usr/bin/env bash
# Launch the MineWorld 2D reference client (clients/2d, step-13 S12).
#
#   ./mineworld-2d                              host worlds/market-town locally and play it as carol
#   ./mineworld-2d --seat visitor               the same world, as somebody else
#   ./mineworld-2d --world worlds/social-cafe   another world
#   ./mineworld-2d --fresh                      start that world over (deletes its local save)
#   ./mineworld-2d --server ADDRESS --invite TOKEN
#                                               join a world someone else is hosting (starts no
#                                               server), with the invite its join line printed
#   ./mineworld-2d --variant=full               another ARC-14 binding set: town (default), full,
#                                               people, procedural
#   ./mineworld-2d --presentation=<dir>|none    another Presentation Pack, or plain drawing
#   ./mineworld-2d --drive[=scenario]           the scripted checks, headless, on a fresh world;
#                                               exits non-zero on failure
#   ./mineworld-2d --drive=walk --capture       the same, windowed, writing stills
#   ./mineworld-2d --drive=farfield [--capture] the far-field check (RL-e0): windowed; the clear
#                                               colour is never on screen; --capture also writes the
#                                               far-field views (--shots=<dir>)
#   ./mineworld-2d --server ADDRESS --invite TOKEN --world-key=KEY
#                                               a joined world is named for its far field
#   ./mineworld-2d --settings=<path>|none       another settings file, or the defaults; play uses the
#                                               shared per-user file (clients/shared/SETTINGS.md §4),
#                                               every scripted run uses none
#   ./mineworld-2d --res=WxH                    this window size for this run (not saved)
#
# Esc opens the in-game settings menu (language, display, clock; Quit is in it).
#
# A hosted world is saved under clients/2d/.save/<world> and resumes on the next launch: the same
# world, the same people where they were. Its server is started on a free port, single-player (--solo),
# with Alice driven by the rule controller (--agent alice; --agent=none for nobody) and a generated host
# token that only the server and the client are given (clients/shared/HOST.md §6). Closing the game
# stops the server gracefully, so reopening resumes the same minute — unless the settings menu's
# "Keep the town running" is chosen, when the server stays up and this script says how to stop it.
# Only this script's own server is ever stopped, never anything found by name.
#
# Needs Godot 4.7 on PATH (brew install godot) or GODOT=/path/to/godot, and cargo for the server.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
proj="$here/clients/2d"
godot_bin="${GODOT:-godot}"
export PATH="$HOME/.cargo/bin:$PATH"

if ! command -v "$godot_bin" >/dev/null 2>&1; then
  echo "error: '$godot_bin' not found on PATH. Install Godot 4.7 (brew install godot)," >&2
  echo "       or set GODOT=/path/to/godot." >&2
  exit 1
fi

world="worlds/market-town"
seat="carol"
server=""
invite="${MINEWORLD_INVITE:-}"
fresh=0
agent="alice"
drive=0
farfield=0
world_key=""
capture=0
res=""
settings=""
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --world)         world="$2"; shift ;;
    --world=*)       world="${1#--world=}" ;;
    --seat)          seat="$2"; shift ;;
    --seat=*)        seat="${1#--seat=}" ;;
    --server)        server="$2"; shift ;;
    --server=*)      server="${1#--server=}" ;;
    --invite)        invite="$2"; shift ;;
    --invite=*)      invite="${1#--invite=}" ;;
    --agent=*)       agent="${1#--agent=}" ;;
    --fresh)         fresh=1 ;;
    --res=*)         res="${1#--res=}" ;;
    --drive=farfield) drive=1; farfield=1; args+=("$1") ;;
    --drive|--drive=*) drive=1; args+=("$1") ;;
    --world-key=*)   world_key="${1#--world-key=}"; args+=("$1") ;;
    --capture)       capture=1; args+=("$1") ;;
    --settings=*)    settings="$1"; args+=("$1") ;;
    *)               args+=("$1") ;;
  esac
  shift
done

# The shared client modules are symlinks (clients/2d/mineworld, clients/2d/mineworld_settings). A
# checkout that did not create them (Windows without core.symlinks) has text files in their place.
for module in mineworld mineworld_settings mineworld_environment mineworld_world_time mineworld_host mineworld_hud mineworld_sitting; do
  if [ ! -d "$proj/$module" ]; then
    echo "error: $proj/$module is not a folder. The shared client modules are symlinks; on Windows run" >&2
    echo "       'git config core.symlinks true' (with Developer Mode on) and check out again." >&2
    exit 1
  fi
done
# A scripted run never reads the player's settings (INV-SET-5); the client enforces it too.
if [ "$drive" = "1" ] && [ -z "$settings" ]; then
  args+=("--settings=none")
fi

# Godot resolves global class names outside the editor only from its resource cache. Build it on the
# first run and whenever a script is newer than it (docs/ACCEPTANCE.md §4.1: a clean checkout works).
cache="$proj/.godot/global_script_class_cache.cfg"
if [ ! -f "$cache" ] || [ -n "$(find -L "$proj/scripts" "$proj/mineworld" -name '*.gd' -newer "$cache" -print -quit)" ]; then
  echo "building the Godot resource cache..."
  "$godot_bin" --headless --path "$proj" --import >/dev/null 2>&1 || true
fi

server_pid=""
scratch=""
hosted=0
# Joining a world hosted elsewhere passes on only a token the user exported themselves (HOST.md §6).
token="${MINEWORLD_ADMIN_TOKEN:-}"
# After a hosted client has exited: the server stops by itself after the client's /admin/stop; if it
# is still running (the client crashed, or an older client) it gets SIGINT on macOS and Linux (graceful),
# then the kill as a last resort (HOST.md §6).
stop_server() {
  local waits=1
  [ "$hosted" = "1" ] && waits=50
  for _ in $(seq 1 "$waits"); do
    kill -0 "$server_pid" 2>/dev/null || { wait "$server_pid" 2>/dev/null || true; return; }
    sleep 0.2
  done
  if [ "$hosted" = "1" ]; then
    case "$(uname -s)" in
      MINGW*|MSYS*|CYGWIN*) ;;
      *) kill -INT "$server_pid" 2>/dev/null || true
         for _ in $(seq 1 25); do
           kill -0 "$server_pid" 2>/dev/null || { wait "$server_pid" 2>/dev/null || true; return; }
           sleep 0.2
         done ;;
    esac
    echo "the server did not stop by itself; stopping it (it loses at most the time since its last checkpoint)" >&2
  fi
  kill "$server_pid" 2>/dev/null || true
  wait "$server_pid" 2>/dev/null || true
}
cleanup() {
  [ -n "$server_pid" ] && stop_server
  [ -n "$scratch" ] && rm -rf "$scratch"
}
trap cleanup EXIT

if [ -z "$server" ]; then
  (cd "$here" && cargo build --quiet -p mineworld-cli) || exit 1
  name="$(basename "$world")"
  if [ "$drive" = "1" ]; then
    # Scripted checks always start from the world as authored, so a run can be compared with the next.
    scratch="$(mktemp -d "${TMPDIR:-/tmp}/mineworld-2d.XXXXXX")"
    save="$scratch/save"
  else
    save="$proj/.save/$name"
    [ "$fresh" = "1" ] && rm -rf "$save"
  fi
  mkdir -p "$(dirname "$save")"
  log="${scratch:-$proj/.save}/server-$name.log"
  agents=()
  [ "$agent" != "none" ] && agents=(--agent "$agent")
  # The host token (HOST.md §6): 32 hex digits from /dev/urandom, given to the server and the client by
  # environment only — never exported, never echoed, never in a log.
  token="$(od -An -tx1 -N16 /dev/urandom | tr -d ' \n')"
  if [ "${#token}" -lt 32 ]; then
    echo "error: could not generate a host token from /dev/urandom" >&2
    exit 1
  fi
  MINEWORLD_ADMIN_TOKEN="$token" "$here/target/debug/mineworld" server "$here/$world" \
    --listen 127.0.0.1:0 --solo --save "$save" ${agents[@]+"${agents[@]}"} > "$log" 2>&1 &
  server_pid=$!
  # Port 0: the system picks a free port. With no --invite the server generates one and prints a
  # single join line, `[mineworld] invite <token> — join with: <address> seat=… invite=<token>`,
  # read here the way mineworld-slice reads it. The invite goes to the client and is never echoed.
  line=""
  for _ in $(seq 1 300); do
    line="$(grep -m1 '^\[mineworld\] invite ' "$log" || true)"
    [ -n "$line" ] && break
    if ! kill -0 "$server_pid" 2>/dev/null; then
      echo "error: the server stopped; its log: $log" >&2
      exit 1
    fi
    sleep 0.2
  done
  if [ -z "$line" ]; then
    echo "error: the server printed no join line; log: $log" >&2
    exit 1
  fi
  invite="$(printf '%s\n' "$line" | sed -n 's/^\[mineworld\] invite \([^ ]*\) .*/\1/p')"
  server="$(printf '%s\n' "$line" | sed -n 's/.* join with: \([^ ]*\) .*/\1/p')"
  echo "world: $world on $server (save: $save)"
  # A played (not scripted) client is told its launcher hosts the world (HOST.md §5).
  if [ "$drive" = "0" ]; then
    hosted=1
    args+=("--hosted-here")
  fi
  # The world the client presents, for its far field (RL-e0): the hosted World Pack's directory name.
  [ -z "$world_key" ] && args+=("--world-key=$name")
fi
# Joining a world hosted elsewhere names it with --world-key=<key>; without one the client refuses
# (FAR_FIELD_WORLD_UNKNOWN) rather than draw some other world's far field.

mode=()
if [ "$drive" = "1" ] && [ "$capture" = "0" ] && [ "$farfield" = "0" ]; then
  mode=(--headless)
elif [ "$capture" = "1" ] || [ "$farfield" = "1" ]; then
  # (--drive=farfield renders frames too, RL-e0 sec.6.4: windowed, on top.)
  # A window the OS considers hidden stops being drawn, and a still then waits forever for a frame:
  # keep the capture window on top. Captures keep their fixed size.
  mode=(--resolution "${res:-1600x900}" --always-on-top)
elif [ -n "$res" ]; then
  # A developer's --res= wins over the saved window size for this run, and is not saved.
  mode=(--resolution "$res")
else
  # Play: the window size is the player's setting (the settings menu), applied by the client.
  mode=()
fi
if [ -z "$invite" ]; then
  echo "error: joining $server needs the invite its server printed: --invite TOKEN" >&2
  exit 1
fi
set +e
MINEWORLD_ADMIN_TOKEN="$token" "$godot_bin" ${mode[@]+"${mode[@]}"} --path "$proj" -- --server="$server" \
  --seat="$seat" --invite="$invite" ${args[@]+"${args[@]}"}
code=$?
set -e
# Exit 10: the player chose "Keep the town running" (HOST.md §5): leave the server up.
if [ "$code" = "10" ] && [ "$hosted" = "1" ]; then
  trap - EXIT
  [ -n "$scratch" ] && rm -rf "$scratch"
  echo "the town keeps running on $server (log: $log)."
  echo "Rejoin with ./mineworld-2d --server $server --invite <the invite in the log's join line>;"
  echo "stop it with Ctrl-C in a terminal that owns it, or: kill -INT $server_pid"
  exit 0
fi
exit "$code"
