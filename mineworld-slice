#!/usr/bin/env bash
# Launch the MineWorld VIS-3D-GODOT-2 environment slice.
#
#   ./mineworld-slice                 walk it
#   ./mineworld-slice --shots         capture the VISUAL_SLICE.md sec.12 review views
#   ./mineworld-slice --drive         walk in through the door, headless, and report
#   ./mineworld-slice --measure       print measured scale against VISUAL_SLICE.md sec.3
#   ./mineworld-slice --threshold     the sec.7.1 indoor/outdoor measurement
#   ./mineworld-slice --perf          frame cost at eight views by RL-b's fixed protocol: three
#                                     fresh runs (an inconclusive run is re-run), the median p95
#                                     per view, and the Default tier's verdict. 1920x1080 unless
#                                     --res=WxH; JSON per run under shots/slice/perf/
#   ./mineworld-slice --perf --breakdown   one run: each cost category switched off in turn
#   ./mineworld-slice --skyline-check headless: the drawn skyline against the summit table
#   ./mineworld-slice --hide-backdrop build the far skyline hidden (frame masks, RL-b V-5)
#   ./mineworld-slice --gi=<mode>     none | ssil | voxel | sdfgi  (default voxel)
#   ./mineworld-slice --hud | --jumpshots | --doors    capture the controls, a jump, every door
#   ./mineworld-slice --character     the character animates; every camera mode, as frames
#
#   ./mineworld-slice --world         start worlds/social-cafe locally and walk it connected
#   ./mineworld-slice --world --link  the same, headless, and check the round trip (sec.9)
#   ./mineworld-slice --world --conversation   windowed: talk to the barista, capture the HUD
#   ./mineworld-slice --world --target         headless: what the targeting ray picks, and
#                                              that it picks nobody through a wall
#   ./mineworld-slice --server=host:port --invite=TOKEN [--seat=visitor] [--nickname=NAME]
#                                     connect to a running world, with the invite its server printed
#
# Needs Godot 4.7 on PATH (brew install godot). --world also needs cargo.
#
# Separate from ./mineworld-3d on purpose: that launches the earlier promenade
# spike, which is the artefact behind an accepted movement and camera decision
# and is left working untouched. Both are scenes in one Godot project, so the
# controller, the cameras, the material library and the CC0 assets are shared
# rather than forked.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
proj="$here/clients/3d-spike"
scene="res://scenes/slice.tscn"
godot_bin="${GODOT:-godot}"
res="1600x900"

if ! command -v "$godot_bin" >/dev/null 2>&1; then
  echo "error: '$godot_bin' not found on PATH. Install Godot 4.7 (brew install godot)," >&2
  echo "       or set GODOT=/path/to/godot." >&2
  exit 1
fi

# Godot resolves global class names outside the editor only from its resource
# cache. Build it on the first run, and rebuild whenever a script is newer than
# the cache: adding a class_name to the tree otherwise fails to parse at startup.
# The same pass imports the props and textures (RL-b SD-RLb-1): the slice draws
# props as imported scenes, so an asset or a committed `.import` newer than the
# last import must be reimported too. A stamp marks the last import, because the
# class cache is not rewritten when no script changed.
cache="$proj/.godot/global_script_class_cache.cfg"
stamp="$proj/.godot/mineworld-import.stamp"
if [ ! -f "$cache" ] || [ ! -f "$stamp" ] \
    || [ -n "$(find "$proj/scripts" -name '*.gd' -newer "$cache" -print -quit)" ] \
    || [ -n "$(find "$proj/scripts" "$proj/assets" -newer "$stamp" \
         \( -name '*.gd' -o -name '*.import' -o -name '*.gltf' -o -name '*.bin' \
            -o -name '*.glb' -o -name '*.jpg' -o -name '*.png' \) -print -quit)" ]; then
  echo "building the Godot resource cache..."
  "$godot_bin" --headless --path "$proj" --import >/dev/null 2>&1 || true
  touch "$stamp"
fi

args=()
headless=0
world=0
perf=0
breakdown=0
res_given=0
gi="voxel"
for a in "$@"; do
  case "$a" in
    --world)                               world=1; continue ;;
    --perf)                                perf=1; args+=("--slice-perf") ;;
    --breakdown)                           breakdown=1; args+=("--perf-breakdown") ;;
    --shots|--drive|--measure|--threshold|--hud|--jumpshots|--doors|--link|--character|--conversation|--target|--skyline-check)
                                           args+=("--slice-${a#--}") ;;
    --gi=*)                                gi="${a#--gi=}"; args+=("$a") ;;
    --res=*)                               res="${a#--res=}"; res_given=1 ;;
    *)                                     args+=("$a") ;;
  esac
  { [ "$a" = "--drive" ] || [ "$a" = "--link" ] || [ "$a" = "--target" ] \
    || [ "$a" = "--skyline-check" ]; } && headless=1
done

# --world: host worlds/social-cafe locally, exactly as clients/protocol/run.sh
# does, connect to it, and stop it when the slice exits. The server listens on a
# port the OS chooses and generates its invite; both are read from the join line
# it prints (server/PROTOCOL.md sec.4.1). Only this script's own server is stopped.
server_pid=""
if [ "$world" = "1" ]; then
  export PATH="$HOME/.cargo/bin:$PATH"
  (cd "$here" && cargo build --quiet -p mineworld-cli) || exit 1
  log="$proj/shots/slice/server.log"
  mkdir -p "$(dirname "$log")"
  "$here/target/debug/mineworld" server "$here/worlds/social-cafe" --listen 127.0.0.1:0 \
    --agent alice > "$log" 2>&1 &
  server_pid=$!
  trap '[ -n "$server_pid" ] && kill "$server_pid" 2>/dev/null' EXIT
  line=""
  for _ in $(seq 1 150); do
    line="$(grep -m1 '^\[mineworld\] invite ' "$log" || true)"
    [ -n "$line" ] && break
    kill -0 "$server_pid" 2>/dev/null || break
    sleep 0.2
  done
  if [ -z "$line" ]; then
    echo "error: the server printed no join line (log: $log)" >&2
    exit 1
  fi
  invite="$(printf '%s\n' "$line" | sed -n 's/^\[mineworld\] invite \([^ ]*\) .*/\1/p')"
  address="$(printf '%s\n' "$line" | sed -n 's/.* join with: \([^ ]*\) .*/\1/p')"
  args+=("--server=$address" "--invite=$invite")
  echo "world: worlds/social-cafe on $address (log: $log)"
fi

# The drive test needs physics, not pixels -- and macOS throttles an unfocused
# window hard enough to make a real-time test take minutes. No `exec` here: a
# server started above must be stopped after Godot exits.
if [ "$headless" = "1" ]; then
  "$godot_bin" --headless --path "$proj" "$scene" -- "${args[@]}"
  exit $?
fi

# --perf (RL-b §3): the Default tier's 1920x1080 unless --res says otherwise. The
# render size is passed to the probe as well, because the project's stretch mode
# renders at a fixed size whatever the window is (slice_perf.gd, M-4). M-5: three
# fresh processes; a run with any measured frame over 250 ms is inconclusive and
# is re-run, up to three times, never averaged in. Each run writes its JSON into
# one session directory, and the last run prints the median over the conclusive
# ones.
if [ "$perf" = "1" ]; then
  [ "$res_given" = "1" ] || res="1920x1080"
  session="$proj/shots/slice/perf/$(date +%Y%m%d-%H%M%S)-${gi}-${res}"
  mkdir -p "$session"
  echo "perf session: $session"
  if [ "$breakdown" = "1" ]; then
    "$godot_bin" --path "$proj" "$scene" --resolution "$res" -- "${args[@]}" \
      "--res=$res" "--perf-out=$session/breakdown.json" 2>&1 | tee "$session/breakdown.log"
    exit "${PIPESTATUS[0]}"
  fi
  for run in 1 2 3; do
    for attempt in 1 2 3 4; do
      out="$session/run$run-a$attempt.json"
      "$godot_bin" --path "$proj" "$scene" --resolution "$res" -- "${args[@]}" \
        "--res=$res" "--perf-out=$out" "--perf-run=$run" 2>&1 | tee "$session/run$run-a$attempt.log"
      if [ ! -f "$out" ]; then
        echo "perf: run $run attempt $attempt wrote no record (see its log)" >&2
        continue
      fi
      grep -q '"inconclusive": false' "$out" && break
      echo "perf: run $run attempt $attempt INCONCLUSIVE; re-running" >&2
    done
  done
  exit 0
fi

"$godot_bin" --path "$proj" "$scene" --resolution "$res" -- "${args[@]:-}"
